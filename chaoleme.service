[Unit]
Description=Chaoleme VPS Overselling Detector
After=network.target

[Service]
Type=simple
User=chaoleme
Group=chaoleme
ExecStart=/opt/chaoleme/bin/chaoleme --config /opt/chaoleme/config/config.yaml
WorkingDirectory=/opt/chaoleme
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
